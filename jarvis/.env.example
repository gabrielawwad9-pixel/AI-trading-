# ============================================================
#  JARVIS settings.  setup.bat copies this file to ".env".
#  Edit .env (NOT this file) with Notepad. Lines starting with # are notes.
# ============================================================

# ---------- BRAIN ----------
# "claude" (online, smartest) or "ollama" (free, runs on your laptop, no internet needed)
LLM_PROVIDER=claude

# Your Claude API key from https://console.anthropic.com/settings/keys  (starts with sk-ant-)
ANTHROPIC_API_KEY=

# claude-sonnet-5-5 = fast and smart (recommended for voice)
# claude-opus-5-5   = smartest, a little slower
# claude-haiku-5-5  = fastest and cheapest
CLAUDE_MODEL=claude-sonnet-5-5

# Only used when LLM_PROVIDER=ollama. Download the model first with:  ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_URL=http://localhost:11434

# Longest reply allowed (in tokens; ~0.75 words each)
MAX_REPLY_TOKENS=400

# ---------- YOU ----------
# Optional: what JARVIS should call you
USER_NAME=

# ---------- EARS ----------
# Wake word sensitivity: lower = hears you more easily (but more false alarms). 0.3 - 0.7
WAKE_THRESHOLD=0.5
WAKE_WORD_MODEL=hey_jarvis

# Speech recognition model: tiny.en (fastest), base.en (balanced), small.en (most accurate, slower)
WHISPER_MODEL=base.en
# "cpu" works everywhere. "cuda" only if you have an NVIDIA graphics card with CUDA set up.
WHISPER_DEVICE=cpu

# Leave blank for the Windows default mic. Or a device number from:  check.bat mic
MIC_DEVICE=

# How loud counts as "speaking" (check.bat mic suggests a value for your room)
SILENCE_LEVEL=400
# How long you must pause before JARVIS decides you've finished talking (seconds)
END_OF_SPEECH_SECONDS=0.9
# After answering, keep listening this many seconds for a follow-up (no wake word needed). 0 = off
FOLLOW_UP_SECONDS=5

# ---------- VOICE ----------
# "edge" = natural Microsoft voice (needs internet)   "piper" = offline voice
TTS_ENGINE=edge
# Calm British male. Others: en-GB-ThomasNeural, en-US-GuyNeural, en-US-AndrewNeural, en-GB-SoniaNeural
EDGE_VOICE=en-GB-RyanNeural
# Speaking speed, e.g. -10% slower, +10% faster
EDGE_RATE=-5%
# Offline voice file (download it with:  check.bat voice --download-piper)
PIPER_VOICE=voices/en_GB-alan-medium.onnx
# Leave blank for the Windows default speakers, or a device number from:  check.bat mic
SPEAKER_DEVICE=
# Little beep when JARVIS hears its name: on / off
CHIME=on

# ---------- INTERRUPTING ----------
# both     = say "Jarvis" OR just start talking to cut it off (best with headphones)
# wakeword = only saying "Jarvis" interrupts (best with laptop speakers)
# voice    = only talking over it   |   off = never interrupt
INTERRUPT_MODE=both
# How loud you must talk over JARVIS to interrupt it (check.bat interrupt suggests a value)
VOICE_INTERRUPT_LEVEL=2500

# ---------- TRADING ----------
# on / off - turn JARVIS's trading features on or off
TRADING=on
# paper = practice account with pretend money (SAFE, default)
# live  = real orders in your Robinhood account (every order still needs you to confirm)
TRADING_MODE=paper
# In live mode, JARVIS refuses any single order bigger than this many dollars
MAX_ORDER_USD=500
# Starting cash for the paper (practice) account
PAPER_STARTING_CASH=10000
# Where prices come from: auto (Robinhood if logged in, otherwise Yahoo Finance), robinhood, yahoo
MARKET_DATA=auto
# How often to check price alerts (seconds)
ALERT_CHECK_SECONDS=60

# Robinhood login (or put these in the trading bot's .env one folder up - JARVIS reads both).
# After filling these in, run:  jarvis login   (approve the login on your phone if asked)
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Only if you use an authenticator app: the SETUP SECRET (not the 6-digit code)
ROBINHOOD_TOTP_SECRET=
